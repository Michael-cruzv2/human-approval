# Copy to .env and fill in local values. Never commit .env.
# Local app runs use the child URL. Set production environment to DATABASE_TARGET=main only after testing succeeds.
DATABASE_TARGET=child
DATABASE_CHILD_URL=
DATABASE_URL=
SESSION_SECRET=
OTP_PEPPER=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=US
EMAIL_FROM=
APP_ORIGIN=http://localhost:3000
# Drafting model: any OpenAI-compatible chat-completions endpoint.
# LLM_BASE_URL is the API root (for example https://api.example.com/v1); the app
# calls POST {LLM_BASE_URL}/chat/completions. All three are required at startup.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
