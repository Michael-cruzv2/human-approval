DATABASE_CHILD_URL=
DATABASE_URL=
SESSION_SECRET=
OTP_PEPPER=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=US
EMAIL_FROM=
APP_ORIGIN=http://localhost:3000
